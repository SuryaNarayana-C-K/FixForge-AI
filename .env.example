# =============================================================================
# FixForge Autonomous Software Repair Platform — Production Configuration (M10)
# =============================================================================
# WARNING: NEVER commit real credentials, tokens, or private keys to git.

# -----------------------------------------------------------------------------
# 1. Core Server & Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=https://fixforge.yourdomain.com

# -----------------------------------------------------------------------------
# 2. Database Configuration (SQLite)
# SQLite is the primary, production-ready database engine.
# In containerized/production environments, mount a persistent volume at /data.
# -----------------------------------------------------------------------------
DATABASE_URL=file:/data/fixforge.db

# -----------------------------------------------------------------------------
# 3. Enterprise Authentication & Security (M9/M10)
# -----------------------------------------------------------------------------
# Generate strong 256-bit secrets using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string
COOKIE_SECURE=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# 4. AI Repair Agent Service (Python FastAPI / LangGraph)
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://fixforge-ai:8000
AI_PORT=8000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
MAX_ITERATIONS=5
SANDBOX_TIMEOUT=120
MAX_MODEL_CALLS=20
MAX_OUTPUT_SIZE=100000
MAX_REPOSITORY_SIZE=50000000
MAX_FILE_SIZE=2000000
MAX_JOB_DURATION=900

# -----------------------------------------------------------------------------
# 5. GitHub Integration & Pull Request Boundary (M6/M9/M10)
# Minimum required GitHub fine-grained permissions:
# - Contents: Read & write (for patch branches & commits)
# - Pull Requests: Read & write (for autonomous PR creation)
# Automated merge is strictly disabled across the platform.
# Set GIT_PROVIDER=mock for isolated local evaluation.
# -----------------------------------------------------------------------------
GIT_PROVIDER=github
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

# -----------------------------------------------------------------------------
# 6. Observability, Telemetry & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
PINO_LOG_LEVEL=info
ENABLE_TELEMETRY=true
METRICS_RETENTION_DAYS=90