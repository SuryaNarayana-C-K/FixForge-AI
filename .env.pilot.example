# =============================================================================
# FixForge Autonomous Software Repair Platform — Private Pilot Environment Template
# =============================================================================
# DO NOT commit real secrets or production credentials in this template.
# Use scripts/generate-pilot-secrets.sh to generate .env.pilot with random secrets.
# =============================================================================

# 1. Environment & Mode
NODE_ENV=production
FIXFORGE_ENV=production
PORT=5000

# 2. Private Network Binding & HTTPS Domain
# For Tailscale VPN: BIND_ADDRESS=100.x.x.x
# For local SSH tunnel: BIND_ADDRESS=127.0.0.1
# For private VPC subnet: BIND_ADDRESS=10.0.x.x
BIND_ADDRESS=127.0.0.1
PILOT_DOMAIN=localhost
TLS_MODE=internal
CORS_ORIGIN=https://localhost

# 3. Database Isolation (Dedicated persistent volume at /data)
DATABASE_URL=file:/data/fixforge.db

# 4. Cryptographic Security Secrets (Minimum 32 characters / 64 hex chars)
# Automatically populated by: bash scripts/generate-pilot-secrets.sh
JWT_SECRET=REPLACE_WITH_GENERATED_64_CHAR_HEX_SECRET
SESSION_SECRET=REPLACE_WITH_GENERATED_64_CHAR_HEX_SECRET
INTERNAL_SERVICE_KEY=REPLACE_WITH_GENERATED_64_CHAR_HEX_SECRET
INTERNAL_WORKER_KEY=REPLACE_WITH_GENERATED_64_CHAR_HEX_SECRET

# 5. Service Topology & Execution Boundaries
AI_SERVICE_URL=http://fixforge-ai:8000
AI_PORT=8000
EXECUTION_MODE=docker
EXECUTION_RUNNER=remote
SANDBOX_WORKER_URL=http://fixforge-sandbox-worker:9000
ALLOW_LOCAL_SUBPROCESS=false
SANDBOX_IMAGE=fixforge-sandbox:latest
SANDBOX_TIMEOUT=120
HOST_WORKSPACE_ROOT=.

# 6. Concurrency & Rate Limiting
MAX_CONCURRENT_REPAIR_JOBS=4
MAX_CONCURRENT_PER_USER=2
MAX_REPAIRS_PER_USER_PER_HOUR=50
MAX_REPAIRS_PER_ORG_PER_HOUR=200

# 7. LLM Provider (Inject your provider API key into .env.pilot; never commit)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# 8. Git Provider Integration (Optional for pilot PR submission)
GIT_PROVIDER=mock
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
