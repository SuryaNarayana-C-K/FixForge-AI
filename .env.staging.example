# =============================================================================
# FixForge Autonomous Software Repair Platform — Staging Environment Template
# =============================================================================
# DO NOT commit real secrets or production credentials in this template.
# Copy this file to .env.staging and populate with secure, locally-generated values.
# =============================================================================

# 1. Environment Identity & Host Binding
NODE_ENV=staging
FIXFORGE_ENV=staging
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1,http://localhost

# 2. Database Isolation (Dedicated persistent staging volume at /data)
DATABASE_URL=file:/data/fixforge.db

# 3. Security Secrets (Minimum 32 characters, cryptographically random)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_locally_generated_64_char_hex_secret
SESSION_SECRET=replace_with_locally_generated_64_char_hex_secret
INTERNAL_SERVICE_KEY=replace_with_locally_generated_service_to_service_secret
INTERNAL_WORKER_KEY=replace_with_locally_generated_worker_service_secret

# 4. Service Boundaries (Internal Compose DNS)
AI_SERVICE_URL=http://fixforge-ai:8000
AI_PORT=8000
EXECUTION_MODE=docker
EXECUTION_RUNNER=remote
SANDBOX_WORKER_URL=http://fixforge-sandbox-worker:9000
ALLOW_LOCAL_SUBPROCESS=false
SANDBOX_IMAGE=fixforge-sandbox:latest
SANDBOX_TIMEOUT=120

# 5. Git & LLM Integration (Mocked / Safe boundary for staging)
GIT_PROVIDER=mock
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
